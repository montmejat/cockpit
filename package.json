{
  "name": "cockpit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A control center for software written with AI agents: the agents' diagrams of the code, live, with files, git, terminals and the agent chat.",
  "scripts": {
    "serve": "tsx src/serve.ts",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "check-arch": "tsx src/check-arch.ts",
    "modules": "tsx src/modules.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.35.0",
    "cytoscape-dagre": "^4.1.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "protobufjs": "^8.8.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  }
}
