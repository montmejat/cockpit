{
  "name": "cockpit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A control center for software written with AI agents: the agents' diagrams of the code, live, with files, git, terminals and the agent chat.",
  "scripts": {
    "serve": "tsx src/serve.ts",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite build --watch --config web/vite.config.ts",
    "check": "tsc --noEmit",
    "check-arch": "tsx src/check-arch.ts",
    "modules": "tsx src/modules.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "svelte": "^5.57.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cytoscape": "^3.35.0",
    "cytoscape-dagre": "^4.1.0",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "protobufjs": "^8.8.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  }
}
